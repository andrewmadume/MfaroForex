  "scripts": {
    "install:ci": "node scripts/install-ci.mjs",
    "dev": "node scripts/run-framework.mjs dev",
    "build": "node scripts/run-framework.mjs build",
    "start": "node --import ./scripts/sites-env.mjs ./node_modules/wrangler/bin/wrangler.js dev --config dist/server/wrangler.json --local --persist-to .wrangler/state --ip 127.0.0.1 --inspector-port 0",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "db:generate": "node --import ./scripts/windows-profile.mjs ./node_modules/drizzle-kit/bin.cjs generate",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "test:api": "node tests/api-smoke.mjs",
    "typecheck": "node scripts/typecheck.mjs",
    "build:vercel": "node --import ./scripts/windows-profile.mjs ./node_modules/next/dist/bin/next build --webpack",
    "dev:vercel": "node --import ./scripts/windows-profile.mjs ./node_modules/next/dist/bin/next dev --webpack",
    "start:vercel": "node --import ./scripts/windows-profile.mjs ./node_modules/next/dist/bin/next start",
    "test:security": "node tests/native-security-smoke.mjs"
  },
