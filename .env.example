# Demo needs no broker secrets. Never prefix privileged secrets with VITE_ or NEXT_PUBLIC_.
# D1 binding is provisioned through .openai/hosting.json.
# Future PostgreSQL deployment only (not used by this build):
DATABASE_URL=
# Future server-only broker adapter (not implemented):
BROKER_PROVIDER=
BROKER_ACCOUNT_ID=
BROKER_API_TOKEN=
LIVE_TRADING_ENABLED=false

# Vercel only: confidential GitHub OAuth application + signed session
# OAuth callback: https://YOUR-PRODUCTION-DOMAIN/auth/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
MFARO_SESSION_SECRET=
MFARO_PUBLIC_URL=
# Vercel only: server-side access to an existing Cloudflare D1 database
# Apply drizzle/0000_fat_chimera.sql to that database before signed-in use.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_D1_DATABASE_ID=
CLOUDFLARE_D1_API_TOKEN=
